{
  "name": "typeorm-unit-of-work-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint:package": "npm run lint:package --workspaces --if-present",
    "check:entry-points": "node scripts/check-entry-points.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/testing": "^12.1.2",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "better-sqlite3": "^12.11.1",
    "pg": "^8.23.1",
    "publint": "^0.3.24",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typeorm": "^1.1.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
