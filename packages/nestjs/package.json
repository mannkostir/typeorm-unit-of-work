{
  "name": "typeorm-unit-of-work-nestjs",
  "version": "0.2.0",
  "description": "NestJS module, @Transactional() and @nestjs/cqrs bridge for typeorm-unit-of-work",
  "license": "MIT",
  "author": "mannkostir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannkostir/typeorm-unit-of-work.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/mannkostir/typeorm-unit-of-work#readme",
  "bugs": {
    "url": "https://github.com/mannkostir/typeorm-unit-of-work/issues"
  },
  "keywords": [
    "nestjs",
    "typeorm",
    "unit-of-work",
    "transactional",
    "cqrs",
    "domain-events",
    "ddd"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "typeorm-unit-of-work": "0.2.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.2.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsup && node ../../scripts/copy-package-docs.mjs",
    "lint:package": "publint --strict && attw --pack ."
  }
}
