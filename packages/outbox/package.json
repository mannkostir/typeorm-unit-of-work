{
  "name": "typeorm-unit-of-work-outbox",
  "version": "0.1.1",
  "description": "Transactional outbox writer for typeorm-unit-of-work: domain events stored as Debezium-compatible outbox rows in the same transaction",
  "license": "MIT",
  "author": "mannkostir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannkostir/typeorm-unit-of-work.git",
    "directory": "packages/outbox"
  },
  "homepage": "https://github.com/mannkostir/typeorm-unit-of-work#readme",
  "bugs": {
    "url": "https://github.com/mannkostir/typeorm-unit-of-work/issues"
  },
  "keywords": [
    "typeorm",
    "unit-of-work",
    "outbox",
    "transactional-outbox",
    "debezium",
    "cdc",
    "domain-events",
    "postgres"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "typeorm": "^0.3.20 || ^1.0.0",
    "typeorm-unit-of-work": "0.1.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "build": "tsup && node ../../scripts/copy-package-docs.mjs",
    "lint:package": "publint --strict && attw --pack ."
  }
}
